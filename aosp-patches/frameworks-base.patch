+/*
+ * Copyright (C) 2024 The Android Open Source Project
+ */
+package android.media.soundtrigger;
+
+@Backing(type="int")
+enum SoundModelType {
+    INVALID = -1,
+    /**
+     * General sound model type.
+     */
+    GENERAL = 0,
+
+    /**
+     * Voice-based sound model type, used in pre-26.2 for keyphrase recognition.
+     */
+    KEYPHRASE_OLD = 1,
+
+    /**
+     * Voice-based sound model type, used for keyphrase recognition.
+     */
+    KEYPHRASE = 2,
+
+    /**
+     * Voice-based sound model type, used for voiceprint (speaker verification) recognition.
+     */
+    VOICEPRINT = 3,
+}

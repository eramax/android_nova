package {
    default_applicable_licenses: ["vendor_nova_license"],
}

java_library {
    name: "nova-framework-host",
    hostdex: true,

    // stem controls the installed filename: <stem>-hostdex.jar
    stem: "nova-framework",

    sdk_version: "none",
    system_modules: "core-public-stubs-system-modules",

    srcs: [
        "src/**/*.java",
        // Direct AOSP framework sources — exclude_srcs works on these paths
        "frameworks/base/core/java/android/view/**/*.java",
        "frameworks/base/core/java/android/widget/**/*.java",
        "frameworks/base/core/java/android/animation/**/*.java",
        "frameworks/base/core/java/android/text/**/*.java",
        "frameworks/base/core/java/android/util/**/*.java",
        "frameworks/base/core/java/com/android/internal/util/**/*.java",
        "frameworks/base/core/java/com/android/internal/view/menu/**/*.java",
        "frameworks/base/core/java/android/window/**/*.java",
        "frameworks/base/graphics/java/android/graphics/**/*.java",
    ],
    exclude_srcs: [
        // Files that reference AIDL-generated interfaces or other deps
        // not available in our partial checkout
        "frameworks/base/core/java/android/view/ViewStub.java",
        "frameworks/base/core/java/android/widget/PopupWindow.java",
        "frameworks/base/core/java/android/widget/Toast.java",
        "frameworks/base/core/java/android/widget/ToastPresenter.java",
        "frameworks/base/core/java/android/widget/VideoView.java",
        "frameworks/base/core/java/android/widget/RemoteViews.java",
        "frameworks/base/core/java/android/widget/RemoteViewsAdapter.java",
        "frameworks/base/core/java/android/widget/RemoteViewsService.java",
        "frameworks/base/core/java/android/widget/Magnifier.java",
        "frameworks/base/core/java/android/widget/Editor.java",
        "frameworks/base/core/java/android/widget/ProgressBar.java",
        "frameworks/base/core/java/android/widget/ScrollView.java",
        "frameworks/base/core/java/android/widget/HorizontalScrollView.java",
        "frameworks/base/core/java/android/widget/SearchView.java",
        "frameworks/base/core/java/android/widget/TabHost.java",
        "frameworks/base/core/java/android/widget/Toolbar.java",
        "frameworks/base/core/java/android/widget/TimePicker.java",
        "frameworks/base/core/java/android/widget/TimePickerClockDelegate.java",
        "frameworks/base/core/java/android/widget/NumberPicker.java",
        "frameworks/base/core/java/android/widget/DropDownListView.java",
        "frameworks/base/core/java/android/widget/ExpandableListView.java",
        "frameworks/base/core/java/android/widget/RadialTimePickerView.java",
        "frameworks/base/core/java/android/widget/RadioGroup.java",
        "frameworks/base/core/java/android/widget/SimpleMonthView.java",
        "frameworks/base/core/java/android/widget/TableLayout.java",
        "frameworks/base/core/java/android/widget/TableRow.java",
        "frameworks/base/core/java/android/widget/SelectionActionModeHelper.java",
        "frameworks/base/core/java/android/widget/DifferentialMotionFlingHelper.java",
        "frameworks/base/core/java/android/widget/inline/InlineContentView.java",
        "frameworks/base/core/java/android/widget/AdapterViewAnimator.java",
        "frameworks/base/core/java/android/widget/CompoundButton.java",
        "frameworks/base/core/java/android/widget/GridView.java",
        "frameworks/base/core/java/android/widget/ListView.java",
        "frameworks/base/core/java/android/widget/Switch.java",
        "frameworks/base/core/java/android/widget/ImageView.java",
        "frameworks/base/core/java/android/text/Html.java",
        "frameworks/base/core/java/android/text/TextLine.java",
        "frameworks/base/core/java/android/text/format/Time.java",
        "frameworks/base/core/java/android/text/format/TimeFormatter.java",
        "frameworks/base/core/java/android/text/style/RasterizerSpan.java",
        "frameworks/base/core/java/android/text/style/StyleSpan.java",
        "frameworks/base/core/java/android/animation/LayoutTransition.java",
        "frameworks/base/core/java/com/android/internal/view/menu/ExpandedMenuView.java",
        "frameworks/base/core/java/com/android/internal/view/menu/IconMenuItemView.java",
        "frameworks/base/core/java/com/android/internal/view/menu/IconMenuView.java",
        "frameworks/base/core/java/com/android/internal/view/menu/SubMenuBuilder.java",
        "frameworks/base/core/java/android/window/**/*.java",
    ],

    // Disable dexpreopt — boot-image-profile.txt not available in master-art partial checkout
    dex_preopt: {
        enabled: false,
    },

    libs: [
        "nova-sdk-android",
        "nova-sdk-art",
        "nova-sdk-framework-graphics",
        "android.view.flags-aconfig-java",
        "com.android.text.flags-aconfig-java",
        "android.view.inputmethod.flags-aconfig-java",
        "android.content.res.flags-aconfig-java",
        "android.appwidget.flags-aconfig-java",
        "android.view.accessibility.flags-aconfig-java",
        "com.android.hardware.input-aconfig-java",
        "android.service.autofill.flags-aconfig-java",
        "android.os.vibrator.flags-aconfig-java",
        "android.app.jank.flags-aconfig-java",
        "android.companion.virtualdevice.flags-aconfig-java",
        "com.android.window.flags.window-aconfig-java",
        "framework_graphics_flags_java_lib",
        "app-compat-annotations",
        "framework-annotations-lib",
        "unsupportedappusage",
        "androidx.annotation_annotation",
    ],

    visibility: ["//vendor/nova:__subpackages__"],
}
